pattern_params = {
"width": 2,
"height": 2,
"kingdom_id": "fungi",
"biome_id": "rich_soil",
"require_adjacent_corpse": true
}
bonus_handler = &"decay_pit"
halo_color = Color(0.8, 0.5, 0.5, 0.55)
