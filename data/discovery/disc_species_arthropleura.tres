script = ExtResource("1")
id = &"disc_species_arthropleura"
title = "Two Meters of Appetite"
body = "It ate what the forest dropped, and the forest dropped a great deal. Where it walked, the litter became nutrients again.
Nothing this big eats this gently anywhere on the planet now."
