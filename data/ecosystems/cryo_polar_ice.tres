[resource]
script = ExtResource("1")
id = &"cryo_polar_ice"
display_name = "Polar Ice Cap"
description = "Thin sun. Thick ice. The fungi here live in the gaps between freezings."
era_id = &"cryogenian"
completion_criterion = &"events_survived"
completion_target = 3.0
