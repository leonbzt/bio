[resource]
script = ExtResource("1")
id = &"disc_node_wood_wide_web"
title = "The Network You Did Not Build"
body = "Sugar flows from the strong tree to the dying one. Nutrients flow up to where they are needed most.
The fungi are the postal service. No one ever paid them in anything but sugar."
category = &"node"
trigger_id = &"wood_wide_web"
