script = ExtResource("1")
id = &"disc_milestone_prestige_5"
title = "Five Lives Lived"
body = "Five times now you have grown, persisted, and returned to substrate.
The world keeps no statue of you. But it remembers, in soil chemistry, that you passed through."
category = &"milestone"
