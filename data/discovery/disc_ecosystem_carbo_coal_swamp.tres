[resource]
script = ExtResource("1")
id = &"disc_ecosystem_carbo_coal_swamp"
title = "The Loop That Buries Itself"
body = "Plants grew, plants died, plants did not finish rotting. Sediment piled on sediment.
Millions of years and the pressure of all that weight turned what you grew into a different rock entirely. You will not see this happen. You are doing it anyway."
category = &"ecosystem"
trigger_id = &"carbo_coal_swamp"
