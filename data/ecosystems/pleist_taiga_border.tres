completion_required_biome = &""
starting_species_filter = Array[StringName]([&"dwarf_willow", &"permafrost_yeast", &"reindeer_lichen"])
unlock_text = "Where the forest tries to creep north. Boggy ground holds the line; willow holds the bog."
complete_text = "The line has not moved. It will not move for ten thousand years. Some borders are kept by patience."
