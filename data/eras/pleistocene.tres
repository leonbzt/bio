[resource]
script = ExtResource("1")
id = &"pleistocene"
display_name = "Ice Age"
description = "Mile-thick ice sheets reshape continents. The world is cold, sparse, and strange. Hairy giants engineer their own grasslands. Fungi and lichen colonize what nothing else can."
available_kingdoms = [&"plantae", &"fungi", &"animals"]
ecosystems = Array[Resource]([ExtResource("2"), ExtResource("3"), ExtResource("4")])
tint_color = Color(0.85, 0.92, 1.0, 1.0)
transition_narrative = "The forests fall. The air cools. Ice creeps south, and the great cathedrals of coal-bark go under it.

A long time passes. A very long time.

When the cold steadies into something almost predictable, things appear at the edges of the ice. They are large. They are warm. They keep the grass alive by walking through it.

You are about to be a sedge, or a moss, or a lichen, or perhaps something much heavier than that.

Begin again."
unlock_requires_prev_era = &"carboniferous"
