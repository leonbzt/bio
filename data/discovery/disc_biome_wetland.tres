[ext_resource type="Script" path="res://scripts/data/discovery_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"disc_biome_wetland"
title = "Where the Cycle Slows"
body = "Standing water, slow decay. Plants die and stay almost whole.
In a million years their bodies will be black rock; in ten million, fire. For now they are just the floor."
category = &"biome"
trigger_id = &"wetland"
