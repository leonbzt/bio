script = ExtResource("1")
id = &"disc_structure_old_growth_stand"
title = "The Canopy Closes"
body = "Sixteen trees stand together long enough that they become a single thing: a forest.\nWhat walks through asking to eat them is turned around. The forest has its own answer."
