script = ExtResource("1")
id = &"disc_species_tree_fern_psaronius"
title = "Frond and Trunk Together"
body = "A crown of fronds on a slim trunk — a tree that hadn't fully committed to being a tree.
The middle layer of every forest in the era. The understory's working majority."
