[resource]
script = ExtResource("1")
id = &"disc_structure_fern_grove"
title = "The Grove Holds Its Own Weather"
body = "Five fronds in a cross. The air between them slows. The ground beneath them stays wet.
Smaller than a forest, larger than a clump. Enough to feed itself."
category = &"structure"
trigger_id = &"fern_grove"
