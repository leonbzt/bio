+@export var title: String = ""
+@export var body: String = ""
+
+# Category drives sectioning in the discovery-log UI and filters in the index.
+# Recognized values: &"kingdom", &"niche", &"node", &"event", &"milestone".
+@export var category: StringName = &""
+
+# Trigger id depends on category. See docs/briefs/phase_9/02_schema_extensions.md.
+@export var trigger_id: StringName = &""
