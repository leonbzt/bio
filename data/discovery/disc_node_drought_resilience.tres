script = ExtResource("1")
id = &"disc_node_drought_resilience"
title = "The Lesson the Dry Years Taught"
body = "Thicker cuticles. Deeper roots. Stomata that close before the sun gets cruel.
The drought did not break you. It only edited what you carry forward."
category = &"node"
trigger_id = &"drought_resilience"
