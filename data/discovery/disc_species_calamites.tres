[ext_resource type="Script" path="res://scripts/data/discovery_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"disc_species_calamites"
title = "The Drowned Forest's First Verticals"
body = "Segmented stalks that grew where the water stood. They fell, and the water held them; they fell again, and the water held them again.
The pile is still down there. Future hands will dig some of it up."
category = &"species"
trigger_id = &"calamites"
